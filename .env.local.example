# URL of the FamCare Ktor backend.
# Run the backend on 8080 so it doesn't conflict with Next.js (3000):
#   cd ../<backend-folder> && PORT=8080 ./gradlew run
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public PostHog project key. Configure it in the deployment environment and
# rebuild after changing it.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key

# Serve canned data instead of calling the backend, for UI-only work — no Ktor
# server, Supabase or Twilio needed. Off by default: a fresh clone should talk
# to a real backend, so nobody spends an afternoon wondering why their changes
# never reach it. Forced off in production builds regardless.
NEXT_PUBLIC_MOCK_API=false

# Which plan the mocked account is on: free | individual | family.
# Only read when NEXT_PUBLIC_MOCK_API=true.
NEXT_PUBLIC_MOCK_PLAN=free

# Artificial delay (ms) on every mocked response. Mocks resolve instantly, so
# loading skeletons never appear locally without this. 3000 is comfortable for
# watching a navigation; leave unset or 0 for normal instant local development.
# Only read when NEXT_PUBLIC_MOCK_API=true.
NEXT_PUBLIC_MOCK_LATENCY_MS=0
