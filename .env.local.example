# URL of the FamCare Ktor backend.
# Run the backend on 8080 so it doesn't conflict with Next.js (3000):
#   cd ../<backend-folder> && PORT=8080 ./gradlew run
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public PostHog project key. Configure it in the deployment environment and
# rebuild after changing it.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
